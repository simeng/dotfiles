shell-integration-features = "ssh-env"

# --- Window ---
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true
background-opacity = 0.8

# --- Font (Iosevka Nerd Font) ---
font-family = "Iosevka Nerd Font"
font-size = 13
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"

# --- Cursor ---
cursor-style = block

# --- Mouse ---
mouse-hide-while-typing = true

# --- Keybindings ---
# Copy / Paste (Super+C/V and Ctrl+Shift+C/V)
keybind = super+c=copy_to_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Font size
keybind = ctrl+shift++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# --- Colors: Campbell (Windows 10 default) ---
# Default colors
background = #000000
foreground = #cccccc

# Normal colors (palette 0-15)
palette = 0=#000000
palette = 1=#c50f1f
palette = 2=#13a10e
palette = 3=#c19c00
palette = 4=#1047da
palette = 5=#801090
palette = 6=#3a96dd
palette = 7=#cccccc

# Bright colors
palette = 8=#464646
palette = 9=#e74856
palette = 10=#16c60c
palette = 11=#f9f9a0
palette = 12=#4b88ff
palette = 13=#b4009e
palette = 14=#61d6d6
palette = 15=#f2f2f2
